<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.pulsestack</groupId>
        <artifactId>pulsestack-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>pulsestack-app</artifactId>
    <name>PulseStack :: Unified Application</name>

    <dependencies>
        <dependency>
            <groupId>dev.pulsestack</groupId>
            <artifactId>auth-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.pulsestack</groupId>
            <artifactId>ingestion-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.pulsestack</groupId>
            <artifactId>processing-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.pulsestack</groupId>
            <artifactId>chat-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>../ingestion-service/src/main/resources/db/migration</directory>
                <targetPath>db/unified</targetPath>
                <filtering>false</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>dev.pulsestack.app.PulseStackApplication</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
